# --- Core ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codcc?schema=public
REDIS_URL=redis://localhost:6379
AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
APP_URL=http://localhost:3000
# 32 bytes, base64 (openssl rand -base64 32). Used for credentials at rest (AES-256-GCM).
ENCRYPTION_KEY=change-me-generate-with-openssl-rand-base64-32
DEFAULT_TIMEZONE=Africa/Algiers
NODE_ENV=development

# --- Files (S3 compatible) ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Email ---
EMAIL_PROVIDER=mock
EMAIL_API_KEY=
EMAIL_FROM=noreply@example.com

# --- Messaging (phase 3) ---
# WhatsApp Business Cloud API; leave empty to use the mock adapter
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
# Meta app secret: verifies X-Hub-Signature-256 on /api/webhooks/whatsapp
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
SMS_PROVIDER=mock
SMS_API_KEY=
# "1" forces the mock messaging adapters even when credentials are set
MESSAGING_MOCK=

# --- Telephony (phase 3) ---
# shared secret of the mock VoIP CDR webhook (/api/webhooks/telephony/mock)
TELEPHONY_WEBHOOK_SECRET=change-me

# --- Shopify (phase 2) ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_SCOPES=read_orders,write_orders,read_products,read_merchant_managed_fulfillment_orders,write_merchant_managed_fulfillment_orders

# --- Couriers (phase 4) ---
COURIER_POLL_MINUTES=20

# --- DZBuild (phase 2) ---
DZBUILD_API_BASE=https://api.dzbuild.app/v1

# --- Payments (phase 6) ---
PAYMENT_GATEWAY=
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=
STRIPE_SECRET_KEY=

# --- Notifications ---
TELEGRAM_BOT_TOKEN=
PUBLIC_TRACKING_BASE_URL=http://localhost:3000

# --- AI (phase 6, optional) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Dev/test switches ---
# "1" enables the Prisma tenant-guard extension that throws on unscoped tenant queries (default on outside production)
TENANT_GUARD=1
# Allow call attempts without proof (flagged in KPIs). Dev only.
ALLOW_MANUAL_CALL_PROOF=1
